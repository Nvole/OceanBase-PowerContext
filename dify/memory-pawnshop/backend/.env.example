# 记忆当铺后端配置。复制为 .env 后按需修改。
# 后端监听地址；Dify 在 Docker 中时保持 0.0.0.0。
PAWNSHOP_HOST=0.0.0.0
PAWNSHOP_PORT=8765

# 账本目录。相对路径以 outputs/memory-pawnshop 为基准。
PAWNSHOP_DATA_DIR=./data

# PowerContext Server。保持末尾不要加斜杠。
POWERCONTEXT_URL=http://127.0.0.1:8000
POWERCONTEXT_TIMEOUT_MS=10000

# PowerContext 开启鉴权时填写；本地默认关闭。
POWERCONTEXT_TOKEN=

# 可选：保护后端接口。设置后，Dify 两个 HTTP 节点需增加
# X-Pawnshop-Key 请求头，值与此处一致。
PAWNSHOP_API_KEY=

PAWNSHOP_LOG_LEVEL=info

